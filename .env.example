# Copy to .env (gitignored). The CLI, API, worker and MCP server read it from the working
# directory; docker compose reads it for variable substitution. Everything is optional for a
# local run: defaults are SQLite + local storage in ./data and heuristic scoring.

# --- core -----------------------------------------------------------------------------------
# EZRA_HOME=./data                      # DB (SQLite), local storage, caches, secrets.enc
# EZRA_DATABASE_URL=postgresql+psycopg://ezra:ezra@localhost:5432/ezra
# EZRA_STORAGE=local                    # local | s3
# EZRA_S3_ENDPOINT=http://localhost:9000   # MinIO / R2; omit for AWS S3
# EZRA_S3_BUCKET=ezra
# EZRA_S3_REGION=us-east-1
# EZRA_S3_ACCESS_KEY=
# EZRA_S3_SECRET_KEY=

# --- API / security ---------------------------------------------------------------------------
# Required when the API is reachable by anyone but you. The dashboard proxy sends it for you.
EZRA_API_TOKEN=
# Encrypts $EZRA_HOME/secrets.enc (OAuth tokens, API keys stored via `ezra secrets set`) and
# signs media links. Use a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
EZRA_SECRET_KEY=
# EZRA_PUBLIC_URL=http://localhost:8000  # base for signed media URLs and OAuth redirect URIs
# EZRA_WEB_URL=http://localhost:3000     # allowed CORS origin / post-OAuth redirect
# EZRA_MAX_UPLOAD_MB=4096
# EZRA_RATE_LIMIT_PER_MINUTE=240
# EZRA_IMPORT_ROOTS=/srv/footage:/home/me/footage   # server-side paths the API/MCP may ingest from

# --- providers -------------------------------------------------------------------------------
# EZRA_TRANSCRIBER=faster-whisper       # faster-whisper | whisperx (uv pip install whisperx)
# EZRA_WHISPER_MODEL=small              # base = faster, large-v3 = best (slow on CPU)
# EZRA_WHISPER_DEVICE=auto
# EZRA_WHISPER_COMPUTE=int8
# EZRA_WHISPER_BATCH=8                  # batched decoding; 0/1 = sequential
# EZRA_WHISPER_PROMPT="Um, uh, like"    # keeps disfluencies so filler removal can see them
# EZRA_MODEL_CACHE=~/.cache/ezra/models
# EZRA_DIARIZER=local                   # local | pyannote (needs HF_TOKEN) | none
# EZRA_FACE_DETECTOR=auto               # auto = YuNet (227 KB model fetched once; Haar if offline) | yunet | haar | mediapipe
# EZRA_TEXT_DETECTOR=auto               # auto = PP-OCRv3 (2.4 MB model fetched once; morphological if offline) | ppocr | morph
# EZRA_LLM=heuristic                    # heuristic | claude-cli | codex-cli | openai-compatible
# EZRA_LLM_MODEL=
# EZRA_LLM_BASE_URL=http://localhost:11434/v1   # openai-compatible: Ollama, LM Studio, vLLM...
# EZRA_LLM_API_KEY=                     # only if that server needs one
# EZRA_FONT_PATH=/path/to/Font-Bold.ttf
# EZRA_BROLL_LIBRARY=/path/to/licensed/broll   # folder of clips you hold rights to
# EZRA_CLIP_ENGINE=native               # native | openshorts
# EZRA_OPENSHORTS_URL=http://localhost:8001
# HF_TOKEN=                             # pyannote community-1 (accept its terms on Hugging Face)
# PEXELS_API_KEY=                       # stock B-roll

# --- publishing (see REMAINING_EXTERNAL_SETUP.md) ------------------------------------------------
# OAuth app credentials as JSON: {"client_id": "...", "client_secret": "..."}
# (for YouTube, Google's downloaded client_secret.json content works as-is)
# YOUTUBE_CLIENT_SECRET_JSON=
# TIKTOK_CLIENT_JSON=
# INSTAGRAM_CLIENT_JSON=
# UPLOAD_POST_API_KEY=                  # optional aggregator (https://upload-post.com); the account
#                                       # handle you register is the Upload-Post profile name:
#                                       # ezra accounts add tiktok upload-post <profile>

# --- worker / automation ------------------------------------------------------------------------
# EZRA_WORKER_POLL_SECONDS=1
# EZRA_JOB_MAX_ATTEMPTS=3
# EZRA_JOB_ISOLATION=true               # run each job in a child process
# EZRA_METRICS_SYNC_HOURS=6             # scheduler cadence for metrics pulls
# EZRA_ALLOW_AUTONOMOUS=0               # 1 + campaign human_approval_required:false = auto-publish PASS clips
# EZRA_MCP_WORKER=1                     # 0: the MCP server doesn't run its own worker

# --- cost estimates (USD) used in reports -------------------------------------------------------
# EZRA_COST_COMPUTE_PER_HOUR=0.10
# EZRA_COST_STORAGE_PER_GB_MONTH=0.023
# EZRA_COST_LLM_PER_1K_TOKENS=0
