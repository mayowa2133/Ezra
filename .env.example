# Copy to .env (gitignored). clipper reads it from the directory you run it in.

# Where the DB, transcripts and renders live (default: ./data)
# CLIPPER_HOME=./data

# Which agent `clipper run` hands judgment to: claude (Claude Code) or codex
# CLIPPER_AGENT=claude

# Local transcription (faster-whisper). small = good default on CPU; base = faster;
# large-v3 = best, slow without a GPU.
# CLIPPER_WHISPER_MODEL=small
# CLIPPER_WHISPER_DEVICE=auto
# CLIPPER_WHISPER_COMPUTE=int8

# Font for burned-in captions (defaults to Arial Black / DejaVu Sans Bold)
# CLIPPER_FONT=/path/to/Font-Bold.ttf

# Publishing via Upload-Post (https://upload-post.com). Free plan: 10 uploads/month;
# TikTok needs a paid tier. USER is the profile name you created in Upload-Post.
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Optional self-hosted OpenShorts (docker compose --profile openshorts up)
# OPENSHORTS_API_URL=http://localhost:8000
# OPENSHORTS_API_KEY=
